# Default to normalized text in the repository.
* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf

# Keep source and docs on LF across platforms.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Keep Windows command scripts on CRLF for local execution.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat generated assets and model artifacts as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary
*.pt binary
*.db binary
events.out.tfevents* binary
